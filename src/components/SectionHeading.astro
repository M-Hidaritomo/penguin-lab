---
import Paw from './Paw.astro';
interface Props {
  id: string;
}
const { id } = Astro.props;
---
<h2 id={id} class="section-heading">
  <Paw size={16} rotate={-15} />
  <span><slot /></span>
  <Paw size={16} rotate={15} />
</h2>
<style>
  .section-heading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    font-size: var(--text-h2);
    line-height: 1.4;
    font-weight: 700;
    text-align: center;
    text-wrap: balance;
  }
</style>
